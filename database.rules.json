{
  "rules": {
    ".read": false,
    ".write": false,
    "personas": {
      ".read": "auth != null && auth.token.email == 'equipo@nombramientos.local'"
    },
    "fotos": {
      ".read": "auth != null && auth.token.email == 'equipo@nombramientos.local'",
      "$id": {
        ".write": "auth != null && auth.token.email == 'equipo@nombramientos.local' && $id.matches(/^([1-9]|[1-9][0-9]|10[0-3])$/)",
        ".validate": "newData.hasChildren(['t']) && newData.child('t').val() == now",
        "t": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
